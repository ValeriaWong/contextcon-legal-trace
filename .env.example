# Copy to .env and fill in locally. NEVER commit .env.
# No real values are in this file. Placeholders only.

# Meko API key — created by Allen himself in the Meko portal
# (Settings > API Keys). Keys start with mko_tkn_ and are shown once.
# Leave empty to run in stub mode (no Meko calls).
MEKO_API_KEY=

# Meko MCP endpoint (verified in docs). Do not change unless the docs change it.
MEKO_MCP_URL=https://mcp.mekodata.ai/mcp

# Datapack to use (create it in the Meko portal first).
MEKO_DATAPACK=legal-audit-synthetic

# Backend: stub (default, no network, no key) or meko (live).
MEKO_BACKEND=stub

# Optional free-model settings. Leave empty unless Allen plugs a free
# model in through src/llm.py. Never put a key here in a committed file.
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
